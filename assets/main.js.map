{
  "schema": 1,
  "id": "example/arena",
  "name": "Example arena score attack",
  "version": "1.0.0",
  "kind": "code",
  "sdk": "^1.0.0",
  "description": "Score points by eliminating enemies before the kill or time limit.",
  "dependencies": {
    "core/world": "^1.0.0",
    "core/enemies": "^1.0.0",
    "core/player": "^1.0.0"
  },
  "capabilities": ["simulation"],
  "config": {
    "playerPrefab": { "type": "string", "label": "Player prefab id", "default": "core/player" },
    "killLimit": { "type": "number", "label": "Kills to win", "default": 30, "min": 1, "max": 1000 },
    "timeLimit": { "type": "number", "label": "Time limit (seconds)", "default": 180, "min": 1, "max": 3600 },
    "spawnInterval": { "type": "number", "label": "Seconds between enemy spawns", "default": 1, "min": 0.05, "max": 60 },
    "maxAlive": { "type": "number", "label": "Maximum living enemies", "default": 8, "min": 1, "max": 100 },
    "minSpawnDistance": { "type": "number", "label": "Preferred spawn distance (m)", "default": 8, "min": 0, "max": 60 },
    "pickupRespawn": { "type": "number", "label": "Pickup respawn time (seconds)", "default": 20, "min": 1, "max": 300 }
  }
}
