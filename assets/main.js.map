            "lens"
          ],
          "once": "took-lens",
          "sound": "story-take"
        },
        {
          "id": "take-cloth",
          "label": "Take the polishing cloth",
          "room": "workshop",
          "text": "A soft cloth, still dry beneath the bench.",
          "add": [
            "cloth"
          ],
          "once": "took-cloth",
          "sound": "story-take"
        },
        {
          "id": "polish",
          "label": "Combine lens + cloth",
