          "motif": "window"
        }
      ],
      "items": {
        "key": {
          "name": "Brass key",
          "icon": "story-key"
        },
        "lens": {
          "name": "Clouded lens",
          "icon": "story-lens"
        },
        "cloth": {
          "name": "Polishing cloth"
        },
