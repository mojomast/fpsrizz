          "sound": "story-inspect"
        },
        {
          "id": "release-catch",
          "label": "Release the brass catch",
          "room": "lantern",
          "require": [
            "clue"
          ],
          "text": "Following the log, you ease the catch free.",
          "flags": [
            "catch"
          ],
          "once": "catch",
          "journal": "The shutter catch is released.",
          "sound": "story-reveal"
