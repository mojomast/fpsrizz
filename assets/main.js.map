          "label": "Raise the shutter",
          "room": "lantern",
          "require": [
            "catch"
          ],
          "text": "The shutter rises without a sound. The sea appears through the glass.",
          "flags": [
            "shutter"
          ],
          "once": "shutter",
          "sound": "story-inspect"
        },
        {
          "id": "install-lens",
          "label": "Install the polished lens",
          "room": "lantern",
          "items": [
