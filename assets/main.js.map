          "label": "Inspect the sea",
          "room": "quay",
          "text": "A single lantern rocks beyond the reef. Someone is waiting for the beacon.",
          "journal": "A boat is stranded beyond the reef.",
          "sound": "story-inspect"
        },
        {
          "id": "speak-kind",
          "label": "Keeper: ask how to help",
          "room": "quay",
          "text": "Mara presses a brass key into your hand. ‘The workshop has the lens. The lamp needs a clear lens and an open shutter.’",
          "add": [
            "key"
          ],
          "flags": [
            "trusted"
          ],
          "once": "met",
          "journal": "Mara says the lamp needs a clear lens and an open shutter.",
          "sound": "story-inspect"
        },
        {
          "id": "speak-blame",
          "label": "Keeper: ask why the light failed",
          "room": "quay",
          "text": "Mara flinches. ‘I closed the shutter when the mechanism jammed. I was afraid I would break it.’ She hands you the workshop key.",
          "add": [
            "key"
          ],
          "flags": [
            "candid"
          ],
          "once": "met",
          "journal": "The shutter jammed; Mara closed it to protect the mechanism.",
          "sound": "story-inspect"
        },
        {
          "id": "keeper-again",
          "label": "Speak with Mara",
          "room": "quay",
          "require": [
            "met"
          ],
          "text": "‘The old log in the workshop explains the shutter. Please bring them home.’",
          "sound": "story-inspect"
        },
        {
          "id": "workshop-door",
          "label": "Unlock the workshop",
          "room": "quay",
          "items": [
            "key"
          ],
          "text": "The key turns. The workshop door opens.",
          "move": "workshop",
          "sound": "story-inspect"
        },
        {
          "id": "to-quay",
          "label": "Return to the quay",
          "room": "workshop",
          "text": "Rain taps against the stones.",
          "move": "quay",
          "sound": "story-inspect"
        },
        {
          "id": "read-log",
          "label": "Inspect the keeper’s log",
          "room": "workshop",
          "text": "The log reads: ‘Release the brass catch before raising the shutter. Never force the wheel.’",
          "flags": [
            "clue"
          ],
          "journal": "Release the brass catch before raising the shutter.",
          "sound": "story-reveal"
        },
        {
          "id": "take-lens",
          "label": "Take the clouded lens",
          "room": "workshop",
          "text": "You lift the clouded lens from its cradle.",
