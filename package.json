{
  "name": "fpsrizz",
  "version": "1.0.0",
  "description": "Bulkhead: a modular, plugin-driven 2.5D first-person shooter foundation",
  "license": "MIT",
  "repository": "github:mojomast/fpsrizz",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/boundaries.ts",
    "test": "node --test \"tests/**/*.test.ts\" tests/validate-game.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "new-plugin": "node scripts/new-plugin.mjs",
    "validate-game": "node scripts/validate-game.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "^7.0.2"
  }
}
