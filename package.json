{
  "name": "fpsrizz",
  "version": "1.0.0",
  "description": "Bulkhead: a modular TypeScript game platform with shooter, racing, tactics, adventure and 3D puzzle experiences",
  "license": "MIT",
  "repository": "github:mojomast/fpsrizz",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "budget": "node scripts/bundle-budget.mjs",
    "schemas": "node scripts/schemas.mjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/boundaries.ts",
    "lint:docs": "node scripts/check-links.mjs",
    "docs:api": "node scripts/docs-api.mjs",
    "test": "node --test \"tests/**/*.test.ts\" \"games/**/*.test.ts\" tests/validate-game.test.mjs tests/reuse-discovery.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:browser": "node scripts/browser-suite.mjs",
    "check": "node scripts/check-node.mjs && node scripts/sync-sdk-version.mjs --check && npm run gen-catalog -- --check && npm run assets -- --check && npm run schemas && npm run typecheck && npm run lint && npm run lint:docs && npm run index-reuse -- --check && npm run budget && npm run test",
    "find-reuse": "node scripts/find-reuse.mjs",
    "index-reuse": "node scripts/index-reuse.mjs",
    "bulkhead": "node scripts/bulkhead.mjs",
    "new-plugin": "node scripts/new-plugin.mjs",
    "validate-game": "node scripts/validate-game.mjs",
    "vendor-three": "node scripts/vendor-three.mjs",
    "graph": "node scripts/game-graph.mjs",
    "gen-catalog": "node scripts/gen-catalog.mjs",
    "pack-painters": "node scripts/pack-painters.mjs",
    "move-to-game": "node scripts/move-to-game.mjs",
    "bench:ecs": "node scripts/bench-ecs.ts",
    "assets": "node scripts/assets.mjs",
    "mcp": "node scripts/mcp-bulkhead.mjs",
    "dev:rpc": "node scripts/dev-rpc-bridge.mjs",
    "perf": "node scripts/perf-report.mjs",
    "export:itch": "node scripts/export-itch.mjs",
    "test:visual": "node scripts/visual.mjs",
    "changeset": "changeset",
    "release:status": "changeset status --verbose",
    "version-packages": "changeset version && node scripts/sync-sdk-version.mjs && npm install --package-lock-only --ignore-scripts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.63.0",
    "@types/three": "0.187.0",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "meshoptimizer": "1.3.0",
    "playwright": "1.63.0",
    "three": "0.187.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "recast-navigation": "0.44.0"
  }
}
