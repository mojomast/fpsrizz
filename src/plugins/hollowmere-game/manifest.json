    "mechanics/inventory": "^1.0.0"
  },
  "capabilities": ["simulation", "input"],
  "requiresRoles": ["sdk/experience", "sdk/platformer", "sdk/capabilities", "sdk/room-map", "sdk/mechanic-inventory"],
