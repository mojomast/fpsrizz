{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Bulkhead SDK",
  "entryPointStrategy": "resolve",
  "tsconfig": "tsconfig.json",
  "out": "docs/reference/api",
  "readme": "none",
  "skipErrorChecking": true,
  "excludeExternals": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "githubPages": false,
  "hideGenerator": true,
  "sort": [
    "kind",
    "alphabetical"
  ],
  "validation": {
    "notExported": false,
    "invalidLink": true,
    "notDocumented": false
  },
  "externalPattern": [
    "**/node_modules/**",
    "**/vendor/**"
  ]
}
